<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" name="UCSC Blocks" xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/squizlabs/PHP_CodeSniffer/master/phpcs.xsd">

	<description>WordPress coding standards for the UCSC Blocks plugin.</description>

	<!-- Scan the whole plugin by default, so `phpcs` needs no path argument. -->
	<file>.</file>

	<!--
	WPCS 3.x dropped its JavaScript and CSS sniffs, so running PHP sniffs over
	.js/.css files only produces noise. Restrict the scan to PHP.
	-->
	<arg name="extensions" value="php"/>

	<!-- Show sniff names in the output so violations are easy to look up. -->
	<arg value="ps"/>

	<!-- Exclude dependency and build directories. -->
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>

	<!--
	build/ is generated by `wp-scripts build`, which copies the PHP sources out
	of src/blocks/. Linting it would report every violation twice.
	-->
	<exclude-pattern>/build/*</exclude-pattern>

	<!-- Include the WordPress-Extra standard. -->
	<rule ref="WordPress-Extra"/>

	<!-- Let's also check that everything is properly documented. -->
	<rule ref="WordPress-Docs"/>

	<!-- Add in some extra rules from other standards. -->
	<rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
		<!--
		The WordPress stand-ins in tests/bootstrap.php mirror core signatures so
		the plugin can be loaded without WordPress, and deliberately ignore most
		of what they are handed.
		-->
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Generic.Commenting.Todo"/>

	<!--
	tests/bootstrap.php defines the stand-ins for wp_strip_all_tags(),
	wp_parse_url() and friends, implementing them in terms of the PHP natives.
	Telling those stubs to call the WordPress alternative is circular, since the
	stub is the alternative.
	-->
	<rule ref="WordPress.WP.AlternativeFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<!-- Likewise, the date_i18n() stub wraps date() on purpose. -->
	<rule ref="WordPress.DateTime.RestrictedFunctions">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<!-- Match the `Requires at least` header in ucsc-blocks.php. -->
	<config name="minimum_supported_wp_version" value="6.5"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="ucsc-blocks"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="ucsc"/>
			</property>
		</properties>
		<!--
		PHPUnit test classes are named for the unit under test and are never
		loaded by WordPress, so the plugin prefix would only obscure them.
		-->
		<exclude-pattern>/tests/*</exclude-pattern>
		<!--
		Block render templates are `require`d from inside the static closure
		that register_block_type_from_metadata() installs as the render
		callback, so their variables are function-scoped rather than global.
		The sniff reads them as globals because it only sees the file.
		-->
		<exclude-pattern>*/render.php</exclude-pattern>
	</rule>

	<!--
	Test classes and their methods are self-describing, and PHPUnit's own
	conventions (testSomething(), @covers) carry the documentation. Requiring
	full docblocks on each one adds noise without adding information.
	-->
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.FunctionComment.Missing">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<!--
	The test file separates groups of tests with `// ─── name ───` dividers.
	Sitting immediately above a method, those read to the sniff as malformed
	function comments; they are section headers.
	-->
	<rule ref="Squiz.Commenting.FunctionComment.WrongStyle">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

</ruleset>
