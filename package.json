{
	"name": "ucsc-blocks",
	"version": "3.0.0",
	"description": "Custom blocks for UCSC WordPress websites.",
	"author": "UC Santa Cruz Communications",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"start": "wp-scripts start --webpack-copy-php",
		"build": "wp-scripts build --webpack-copy-php",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"release": "npx commit-and-tag-version",
		"dryrun": "npx commit-and-tag-version --dry-run",
		"test": "wp-scripts test-unit-js",
		"test:watch": "wp-scripts test-unit-js --watch"
	},
	"devDependencies": {
		"@ucsantacruz/wordpress-version-updater": "^1.1.1",
		"@wordpress/scripts": "^30.15.0",
		"typescript": "^5.9.2"
	},
	"files": [
		"build",
		"vendor",
		"ucsc-blocks.php",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"commit-and-tag-version": {
		"bumpFiles": [
			{
				"filename": "ucsc-blocks.php",
				"updater": "wordpress-version-updater.js"
			},
			{
				"filename": "package-lock.json",
				"type": "json"
			},
			{
				"filename": "package.json",
				"type": "json"
			}
		]
	}
}
